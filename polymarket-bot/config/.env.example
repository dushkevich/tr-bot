# ============================================================
# Polymarket AI Geopolitical Trading Bot — Environment Config
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# -----------------------------------------------------------
# Wallet (Polygon)
# -----------------------------------------------------------
POLY_PRIVATE_KEY=0x...            # Polymarket wallet private key
POLY_FUNDER_ADDRESS=0x...         # Public address corresponding to POLY_PRIVATE_KEY

# -----------------------------------------------------------
# LLM APIs — tiered routing
# -----------------------------------------------------------
OPENROUTER_API_KEY=sk-or-...      # OpenRouter (free tier for matching/summarization)
ANTHROPIC_API_KEY=sk-ant-...      # Claude Sonnet (paid, probability estimation only)
NVIDIA_API_KEY=nvapi-...          # NVIDIA NIM fallback (free alternative for Tier 1)

# -----------------------------------------------------------
# Model routing
# -----------------------------------------------------------
FREE_MODEL=deepseek/deepseek-chat-v3-0324:free   # OpenRouter free model for matching/summarization
PAID_MODEL=claude-sonnet-4-6                      # Claude Sonnet via Anthropic SDK directly
USE_LOCAL_OLLAMA=false                            # Set true if running local Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# -----------------------------------------------------------
# Discord
# -----------------------------------------------------------
DISCORD_BOT_TOKEN=...
DISCORD_ALERTS_CHANNEL_ID=...     # #alerts — kill switch, losses, API failures
DISCORD_SIGNALS_CHANNEL_ID=...    # #signals — trade executed / signal log
DISCORD_SUMMARY_CHANNEL_ID=...    # #daily-summary — 23:55 UTC end-of-day report

# -----------------------------------------------------------
# Trading parameters
# -----------------------------------------------------------
DIVERGENCE_THRESHOLD=0.08         # 8 percentage points minimum to trade
MAX_TRADE_SIZE_USDC=50            # Max per single trade (USDC)
MAX_TOTAL_EXPOSURE_USDC=500       # Max total capital deployed (USDC)
MAX_SINGLE_MARKET_PCT=0.05        # 5% of portfolio per market
MAX_DAILY_LOSS_USDC=50            # Kill switch trigger: daily loss limit
MIN_BALANCE_USDC=50               # Kill switch trigger: minimum balance
MAX_OPEN_POSITIONS=20
SCAN_INTERVAL_SECONDS=900         # 15 minutes
DRY_RUN=true                      # Start here! Paper trading mode.

# -----------------------------------------------------------
# Calibration
# -----------------------------------------------------------
PLATT_SCALING_RETRAIN_DAYS=30     # Retrain calibration model monthly
BRIER_SCORE_PAUSE_THRESHOLD=0.30  # Pause trading if Brier exceeds this
COLD_START_MIN_SAMPLES=20         # Min resolved markets before enabling Platt Scaling

# -----------------------------------------------------------
# Dashboard
# -----------------------------------------------------------
DASHBOARD_PORT=3000
DASHBOARD_API_PORT=8000
DASHBOARD_SECRET=change-me        # Authorization header value for POST /api/kill-switch
